# Скопируйте в .env для локального запуска или воспользуйтесь start-скриптом.
# Для облака deploy-скрипт создаёт отдельный .env.cloud.
# Никогда не публикуйте настоящий токен или пароль в Git.

# Токен бота от @BotFather (обязательно).
BOT_TOKEN=
# Локально можно оставить пустым; в облаке прокси обязателен.
# Примеры: http://user:password@proxy.example:3128 или socks5://proxy.example:1080
# Символы @, :, / в логине/пароле кодируйте как %40, %3A, %2F.
TELEGRAM_PROXY_URL=

# Локально: 127.0.0.1 и опубликованный порт. В облаке: db и 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bot
POSTGRES_USER=bot
# Скрипт сгенерирует пароль, если поле пустое. После создания БД не меняйте его
# только в env-файле: пароль роли PostgreSQL хранится внутри самой БД.
POSTGRES_PASSWORD=

LOG_LEVEL=INFO
# Служебный HTTP-порт на 127.0.0.1; наружу в облаке не публикуется.
HEALTH_PORT=8080

# --- Языковая модель (лабораторная № 1) ---
# Адрес OpenAI-совместимого API без /chat/completions (обязательно).
# Примеры: https://api.openai.com/v1, https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1
# Ключ доступа к API (обязательно). Пример формата, не настоящий ключ: sk-example-not-a-real-key
LLM_API_KEY=
# Имя модели у выбранного провайдера (обязательно), например gpt-4.1-mini.
LLM_MODEL=
# Необязательный HTTP/SOCKS5-прокси только для запросов к LLM API.
LLM_PROXY_URL=
# Таймаут одного запроса к модели, секунды.
LLM_TIMEOUT_SECONDS=60
# Максимум токенов в ответе модели.
LLM_MAX_OUTPUT_TOKENS=1000
# Повторы только при временных ошибках (429, 5xx, обрыв соединения).
LLM_MAX_RETRIES=1

# Ограничения истории диалога, передаваемой модели.
# Сообщений истории (пользователь + ассистент) в одном запросе.
HISTORY_MAX_MESSAGES=20
# Оценочный объём запроса в символах: инструкция + история + новое сообщение (не меньше 8000).
HISTORY_MAX_CHARS=12000
